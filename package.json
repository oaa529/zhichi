{
  "name": "wechat-realism",
  "private": true,
  "version": "0.0.1",
  "description": "UI 1:1 复刻微信 + 内核为极致拟真 AI RP 的应用",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @wechat-rp/web dev",
    "build": "pnpm -r --filter=./packages/* build",
    "build:web": "pnpm --filter @wechat-rp/web build",
    "desktop:dev": "pnpm --filter @wechat-rp/desktop dev",
    "desktop:build": "pnpm --filter @wechat-rp/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

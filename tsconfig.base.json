{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@wechat-rp/shared-types": ["./shared/types/src/index.ts"],
      "@wechat-rp/shared-types/*": ["./shared/types/src/*"],
      "@wechat-rp/core": ["./packages/core/src/index.ts"],
      "@wechat-rp/core/*": ["./packages/core/src/*"],
      "@wechat-rp/ui-wechat": ["./packages/ui-wechat/src/index.ts"]
    }
  }
}

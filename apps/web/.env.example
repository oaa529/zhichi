# LLM 配置
# 适配器类型：openai / claude / mock（默认 mock）
VITE_LLM_ADAPTER=mock

# OpenAI 兼容端点（也兼容 Kimi/DeepSeek/通义千问）
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_API_KEY=your-api-key-here
# VITE_LLM_MODEL=gpt-4o-mini

# Claude 端点
# VITE_LLM_BASE_URL=https://api.anthropic.com
# VITE_LLM_API_KEY=your-api-key-here
# VITE_LLM_MODEL=claude-3-5-sonnet-20241022

# 通用配置
VITE_LLM_TIMEOUT_MS=30000
VITE_LLM_MAX_RETRIES=3
VITE_LLM_TEMPERATURE=800
VITE_LLM_MAX_TOKENS=1024
